# =============================================================================
# PRESENTON ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control
# =============================================================================

# =============================================================================
# POSTGRESQL DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database credentials (used when running with Docker Compose)
POSTGRES_DB=presenton
POSTGRES_USER=presenton
POSTGRES_PASSWORD=change_this_secure_password

# PostgreSQL port (exposed on host for management tools like pgAdmin, DBeaver, etc.)
POSTGRES_PORT=5432

# Database URL - This will be auto-constructed if using Docker Compose postgres service
# Format: postgresql://username:password@host:port/database
# For external PostgreSQL, set this manually:
# DATABASE_URL=postgresql://user:password@your-db-host:5432/presenton

# For SQLite (legacy/development):
# DATABASE_URL=sqlite:///app_data/presenton.db

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Allow users to change API keys from the UI (true/false)
CAN_CHANGE_KEYS=true

# Enable custom template creation from PPTX files (true/false)
ENABLE_CUSTOM_TEMPLATES=false

# Disable anonymous usage telemetry (true/false)
DISABLE_ANONYMOUS_TRACKING=false

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Choose your LLM provider: openai, google, anthropic, ollama, custom
LLM=openai

# --- OpenAI Configuration ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google Gemini Configuration ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash-exp

# --- Anthropic Claude Configuration ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Ollama Configuration (Local LLM) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Custom OpenAI-Compatible API Configuration ---
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_MODEL=

# =============================================================================
# LLM FEATURES
# =============================================================================
# Enable tool/function calling for custom LLMs (true/false)
TOOL_CALLS=false

# Disable thinking/reasoning tokens for custom LLMs (true/false)
DISABLE_THINKING=false

# Enable extended reasoning mode (true/false)
EXTENDED_REASONING=false

# Enable web search/grounding for OpenAI, Google, and Anthropic (true/false)
WEB_GROUNDING=false

# =============================================================================
# IMAGE GENERATION CONFIGURATION
# =============================================================================
# Image provider: dall-e-3, gemini_flash, pexels, pixabay
# Defaults: dall-e-3 for OpenAI, gemini_flash for Google
IMAGE_PROVIDER=dall-e-3

# --- Stock Photo APIs ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Note: DALL-E 3 uses OPENAI_API_KEY, Gemini Flash uses GOOGLE_API_KEY

# =============================================================================
# SYSTEM PATHS (Auto-configured in Docker, customize for local dev)
# =============================================================================
# Directory for user data and generated files
APP_DATA_DIRECTORY=/app_data

# Temporary files directory
TEMP_DIRECTORY=/tmp/presenton

# Path to user configuration file (auto-set by start.js)
# USER_CONFIG_PATH=/app_data/userConfig.json

# Chromium executable path for Puppeteer (PDF/PPTX export)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# =============================================================================
# DEVELOPMENT / ADVANCED OPTIONS
# =============================================================================
# Use custom URL for API endpoints (advanced)
# USE_CUSTOM_URL=

# Node environment (production/development)
# NODE_ENV=production
