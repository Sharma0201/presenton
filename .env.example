# =============================================================================
# PRESENTON ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=presenton
POSTGRES_USER=presenton
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_PORT=5432

# Optional: Override with external PostgreSQL or use SQLite
# DATABASE_URL=postgresql://user:password@external-host:5432/presenton
# DATABASE_URL=sqlite:///app_data/presenton.db

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
CAN_CHANGE_KEYS=true
ENABLE_CUSTOM_TEMPLATES=false
DISABLE_ANONYMOUS_TRACKING=false

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Choose: openai, google, anthropic, ollama, custom
LLM=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash-exp

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Custom OpenAI-Compatible API
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_MODEL=

# =============================================================================
# LLM FEATURES
# =============================================================================
TOOL_CALLS=false
DISABLE_THINKING=false
EXTENDED_REASONING=false
WEB_GROUNDING=false

# =============================================================================
# IMAGE GENERATION
# =============================================================================
# Provider: dall-e-3, gemini_flash, pexels, pixabay
IMAGE_PROVIDER=dall-e-3

PEXELS_API_KEY=
PIXABAY_API_KEY=
